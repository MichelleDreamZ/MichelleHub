local function ShowDoxxScreen()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Vangeliicide"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 999
	gui.ResetOnSpawn = false
	gui.Parent = playerGui

	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(0, 18, 0)
	bg.BorderSizePixel = 0
	bg.Parent = gui

	-- Continuous infinite rain
	local function createRainColumn()
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0, 14, 0, 1400)
		label.Position = UDim2.new(math.random(), 0, -2, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(0, 255, 70)
		label.TextTransparency = 0.25
		label.Font = Enum.Font.Code
		label.TextSize = 13
		label.Text = ""
		for _ = 1, 60 do
			label.Text = label.Text .. tostring(math.random(0,1)) .. "\n"
		end
		label.Parent = bg

		local function fall()
			label.Position = UDim2.new(math.random(), 0, -2.2, 0)
			local speed = math.random(7, 13)
			local tween = TweenService:Create(label, TweenInfo.new(speed, Enum.EasingStyle.Linear), {
				Position = UDim2.new(label.Position.X.Scale, 0, 2.5, 0)
			})
			tween:Play()
			tween.Completed:Connect(function()
				fall()
			end)
		end
		fall()
	end

	for i = 1, 90 do
		createRainColumn()
	end

	-- Keep generating more columns over time
	task.spawn(function()
		while true do
			task.wait(0.4)
			createRainColumn()
		end
	end)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 70)
	title.Position = UDim2.new(0, 0, 0.34, 0)
	title.BackgroundTransparency = 1
