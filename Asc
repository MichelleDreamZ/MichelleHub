	title.TextColor3 = Color3.fromRGB(0, 255, 90)
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 58
	title.Parent = bg

	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.new(1, 0, 0, 45)
	sub.Position = UDim2.new(0, 0, 0.45, 0)
	sub.BackgroundTransparency = 1
